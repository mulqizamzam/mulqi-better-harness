{
  "name": "mulqi-better-harness",
  "version": "0.1.0",
  "description": "Native DeepSeek Harness plugin that publishes the better-harness review skill (explicit-only /better-harness gesture), its analysis CLI, and the resource trees the workflow needs.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "mulqi-better-harness": "scripts/better-harness.mjs"
  },
  "files": [
    "index.js",
    "lib/**",
    "skills/**",
    "scripts/**",
    "references/**",
    "models/**",
    "templates/**",
    "cordis.patch.yml",
    "docs/**",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.20.0"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "0.3.1",
    "esbuild-wasm": "0.28.2",
    "yaml": "2.9.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "better-harness",
    "harness-review",
    "coding-agent",
    "harness-engineering",
    "skill"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "engines": {
      "dsh": "0.2.1-rc.2"
    }
  }
}
